# Serverbestanden moeten LF-regeleindes houden.
# Met CRLF kan Apache directieven in .htaccess verkeerd interpreteren.
.htaccess       text eol=lf
googlec*.html   text eol=lf

# Overige tekstbestanden: consistent LF, ongeacht besturingssysteem
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.xml           text eol=lf
*.txt           text eol=lf
*.svg           text eol=lf
*.md            text eol=lf

# Binair
*.png           binary
